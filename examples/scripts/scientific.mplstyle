# Scientific plot style (house style)
font.family: sans-serif
font.sans-serif: Helvetica, Helvetica Neue, Arial, DejaVu Sans
font.size: 12
text.color: 0.15

axes.titlesize: 18
axes.titleweight: medium
axes.titlepad: 10
figure.titlesize: 18
axes.labelsize: 15
axes.labelweight: medium
axes.labelcolor: 0.15
axes.labelpad: 8

xtick.labelsize: 13
xtick.color: 0.15
xtick.direction: in
xtick.top: True
xtick.bottom: True
xtick.major.size: 4
xtick.major.width: 1.0
xtick.minor.visible: False

ytick.labelsize: 13
ytick.color: 0.15
ytick.direction: in
ytick.left: True
ytick.right: True
ytick.major.size: 4
ytick.major.width: 1.0
ytick.minor.visible: False

mathtext.fontset: custom
mathtext.rm: Helvetica
mathtext.it: Helvetica
mathtext.bf: Helvetica
mathtext.sf: Helvetica
mathtext.tt: Helvetica

axes.facecolor: white
axes.edgecolor: 0.15
axes.linewidth: 1.5
axes.grid: True
axes.axisbelow: True

grid.color: 0.9
grid.linestyle: -
grid.linewidth: 0.8

axes.prop_cycle: cycler('color', ['000000', 'e31a1c', '9677b8', 'fdbf6f', '33a02c', 'e8d8fc', 'fb9a99', 'b2df8a'])

lines.linewidth: 3
lines.solid_capstyle: round
lines.markersize: 8
lines.markeredgewidth: 1.2
lines.dash_capstyle: round

legend.frameon: False
legend.fontsize: 13
legend.handlelength: 2.2
legend.handletextpad: 0.7
legend.labelspacing: 0.35
legend.columnspacing: 1.2
legend.borderaxespad: 0.5

figure.figsize: 9, 6
figure.dpi: 100
figure.facecolor: white
savefig.dpi: 300
savefig.facecolor: white
savefig.transparent: False
